{
  "name": "vick-control-center",
  "productName": "Vick Control Center",
  "version": "0.1.0",
  "description": "Central de controle para a telinha 1920x480",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist:win": "electron-vite build && electron-builder --win portable --x64",
    "dist:win:installer": "electron-vite build && electron-builder --win nsis --x64",
    "shots": "electron-vite build && electron scripts/screenshots.cjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "preact": "^11.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
